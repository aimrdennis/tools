---
import "../styles/global.css";
import "../styles/layout.css";
import "../styles/blog.css";
import "../styles/article.css";

import SeoHead from "../components/SeoHead.astro";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import { generateFaqSchema } from "../lib/utils";

const {
  title,
  description,
  canonical,
  image = null,
  type = "website",
  html = "",
  articleSchema = null,
  breadcrumbs = null,
  amp = null,
  slug = ""
} = Astro.props;

const faqSchema = generateFaqSchema(html);
---

<!doctype html>

<html lang="id">

<head>

  <SeoHead
    title={title}
    description={description}
    canonical={canonical}
    image={image}
    type={type}
    slug={slug}
    faqSchema={faqSchema}
    articleSchema={articleSchema}
    breadcrumbs={breadcrumbs}
    amp={amp}
  />

</head>

<body>

  <Header />

  <div class="main-layout">

    <main class="container">
      <slot />
    </main>

  </div>

  <Footer />

<style is:global>
.popers{margin:0;padding:0;font-family:'Playfair Display','Segoe UI',serif;color:#00c8ff}.popup-overlay{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;z-index:9999;background:rgb(0 0 0/.4);backdrop-filter:blur(3px)}.popup-container{position:relative;width:90%;max-width:420px;padding-bottom:20px;overflow:hidden;text-align:center;border:1px solid rgb(0 200 255/.2);border-radius:20px;background:linear-gradient(145deg,rgb(10 10 10/.95),rgb(16 26 25/.9));box-shadow:0 20px 40px #000b,0 0 25px rgb(0 200 255/.3);backdrop-filter:blur(10px);animation:popupIn .7s cubic-bezier(.175,.885,.32,1.275)}.popup-container::before{content:"";position:absolute;inset:-100%;background:linear-gradient(135deg,#fff0 45%,rgb(0 229 255/.25) 50%,#fff0 55%);animation:shine 5s linear infinite;pointer-events:none}.popup-image{width:100%;display:block;border-bottom:1px solid rgb(0 200 255/.15)}.clk-btn-sgp{position:relative;display:grid;grid-template-columns:repeat(2,1fr);gap:15px;padding:20px}.clk-btn-sgp a{position:relative;padding:15px 12px;text-align:center;text-transform:uppercase;letter-spacing:1.5px;font-family:Poppins,sans-serif;font-weight:700;border-radius:14px;text-decoration:none;transition:.3s ease;box-shadow:0 8px #000}.clk-btn-sgp a:hover{transform:translateY(-5px)}.login{color:#29e4ff!important;background:linear-gradient(145deg,#525053,#000);border:2px solid #00c8ff}.login:hover{color:#dcf9ff!important;box-shadow:0 12px 20px rgb(0 200 255/.35)}.register{color:#00151d!important;border:2px solid #7ff6ff;background:linear-gradient(135deg,#5df8ff,#00d5ff 25%,#009cff 55%,#006dff,#3ad7ff);box-shadow:inset 0 1px #fff6,0 8px 20px rgb(0 180 255/.35)}.register:hover{background:linear-gradient(135deg,#8cffff,#24e6ff 25%,#00b8ff 50%,#0075ff,#42f3ff);box-shadow:0 12px 28px rgb(0 200 255/.5)}.popup-footer{position:relative;z-index:2;padding:10px;color:#ccc;font:13px/1.6 'Playfair Display',serif}.close-btn{position:absolute;top:15px;right:15px;z-index:10;width:32px;height:32px;border:1px solid rgb(0 200 255/.3);border-radius:50%;background:#0008;cursor:pointer;transition:.3s}.close-btn::before,.close-btn::after{content:"";position:absolute;top:14px;left:8px;width:16px;height:2px;background:#00c8ff}.close-btn::before{transform:rotate(45deg)}.close-btn::after{transform:rotate(-45deg)}.close-btn:hover{background:rgb(0 200 255/.8);transform:rotate(90deg)}@keyframes popupIn{from{opacity:0;transform:scale(.5) rotate(-8deg)}to{opacity:1;transform:scale(1) rotate(0)}}@keyframes shine{from{transform:translate(-50%,-50%) rotate(30deg)}to{transform:translate(50%,50%) rotate(30deg)}}@media(max-width:768px){.clk-btn-sgp{grid-template-columns:1fr;gap:12px}}@media(max-width:480px){.popup-container{width:95%;max-width:350px}.popup-footer{font-size:12px}.close-btn{width:28px;height:28px}}
</style>

<div class="popup-overlay" id="popup">
  <div class="popup-container"><button class="close-btn" type="button" aria-label="Tutup"></button>
  <img class="popup-image" src="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhWFfArsRyLiWyAJKTTssYYkMuBfx7k3cYRlWUzAlpTXjV6Hqr8JwviqG2csp8SMb-ADl8a0Bmxt2xx8Ws4OeCfT8I82h_gfdwhMLOLGOys8gbWWHsz7P0723vLFWyxPe36VpLwLOtchkgxYr3hAgdxiniKUDW5LjZrJVBLQKimp92s9Os_9VaJ79YgDyn0/s1600/mr-dennis-1.webp" alt="Promo" loading="eager">
    <div class="clk-btn-sgp"><a class="login" href="https://apk.mrdennis.workers.dev/">Login</a><a class="register" href="https://apk.mrdennis.workers.dev/">Daftar</a></div>
    <div class="popup-footer"> Tools Ai Mr Dennis </div>
  </div>
</div>
<script>
const popup=document.getElementById("popup");const closeBtn=popup.querySelector(".close-btn");closeBtn.addEventListener("click",()=>{popup.style.display="none"});popup.addEventListener("click",(e)=>{if(e.target===popup){popup.style.display="none"}})
</script>

</body>

</html>
