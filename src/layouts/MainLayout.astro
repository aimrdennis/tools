---
import "../styles/global.css";
import "../styles/layout.css";
import "../styles/blog.css";
import "../styles/article.css";

import SeoHead from "../components/SeoHead.astro";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import { generateFaqSchema } from "../lib/utils";

const {
  title,
  description,
  canonical,
  image = null,
  type = "website",
  html = "",
  articleSchema = null,
  breadcrumbs = null,
  amp = null,
  slug = ""
} = Astro.props;

const faqSchema = generateFaqSchema(html);
---

<!doctype html>

<html lang="id">

<head>

  <SeoHead
    title={title}
    description={description}
    canonical={canonical}
    image={image}
    type={type}
    slug={slug}
    faqSchema={faqSchema}
    articleSchema={articleSchema}
    breadcrumbs={breadcrumbs}
    amp={amp}
  />

</head>

<body>

  <Header />

  <div class="main-layout">

    <main class="container">
      <slot />
    </main>

  </div>

  <Footer />
<style>@keyframes spinIn{0%{opacity:0;transform:scale(.6) rotate(-360deg)}70%{opacity:1;transform:scale(1.04) rotate(12deg)}100%{transform:scale(1) rotate(0)}}@keyframes spinOut{0%{opacity:1;transform:scale(1) rotate(0)}100%{opacity:0;transform:scale(.6) rotate(360deg)}}#jt-popup{position:fixed;z-index:9999;inset:0;background:radial-gradient(circle at top,rgba(212,175,55,.18),transparent 38%),radial-gradient(circle at bottom,rgba(120,54,0,0.22),transparent 42%),rgba(0,0,0,.78);backdrop-filter:blur(7px);display:flex;align-items:center;justify-content:center;padding:16px}#jt-popup-box{position:relative;display:flex;flex-direction:column;align-items:center;width:100%;max-width:400px;padding:12px;border-radius:22px;background:linear-gradient(135deg,rgba(255,255,255,.12),transparent 28%),linear-gradient(180deg,#028100 0%,#120005 48%,#050001 100%);border:1px solid rgb(3,128,55);box-shadow:0 0 0 1px rgba(212,175,55,.22),0 0 28px rgba(212,175,55,.42),0 18px 45px rgba(0,0,0,.85);animation:spinIn .7s cubic-bezier(.2,.9,.3,1);overflow:visible}#jt-popup-box::before{content:"";position:absolute;inset:8px;border-radius:18px;border:1px solid rgba(255,255,255,.08);pointer-events:none}#jt-popup-box::after{content:"";position:absolute;top:-2px;left:16%;width:68%;height:2px;background:linear-gradient(90deg,transparent,#fff3b0,#d4af37,transparent);box-shadow:0 0 14px rgba(245,215,110,.8);pointer-events:none}#jt-close{position:absolute;top:-13px;right:-13px;width:36px;height:36px;border-radius:50%;border:1px solid rgba(255,232,150,.85);cursor:pointer;font-size:18px;font-weight:900;color:#fff8dc;background:linear-gradient(135deg,#ffef9a 0%,#252524 38%,#028100 100%);box-shadow:0 0 14px rgba(212,175,55,.65),0 5px 14px rgba(0,0,0,.75);text-shadow:0 2px 3px rgba(0,0,0,.8)}#jt-close:hover{transform:scale(1.08);box-shadow:0 0 20px rgba(245,215,110,.85),0 6px 16px rgba(0,0,0,.85)}#jt-popup-img{width:100%;border-radius:16px;border:1px solid rgba(255,220,120,.55);box-shadow:0 0 18px rgba(212,175,55,.36),0 10px 26px rgba(0,0,0,.85);margin-bottom:16px}.jt-button-wrap{display:flex;gap:10px;width:100%;margin-bottom:16px}.jt-popup-btn{flex:1;height:46px;line-height:46px;text-align:center;font-weight:900;font-size:15px;color:#ffffff;text-decoration:none;border-radius:12px;font-family:'Segoe UI',sans-serif;letter-spacing:.8px;text-transform:uppercase;position:relative;overflow:hidden;border:1px solid rgba(255,232,150,.85);background:linear-gradient(135deg,rgba(255,255,255,.28),transparent 30%),linear-gradient(180deg,#028100 0%,#028100 38%,#000000 100%);text-shadow:0 2px 4px rgba(0,0,0,.9);box-shadow:inset 0 1px 0 rgba(255,255,255,.38),0 0 16px rgba(212,175,55,.45),0 5px 0 rgba(112,54,36,0.95),0 8px 18px rgba(0,0,0,.5);transition:.28s ease}.jt-popup-btn::before{content:"";position:absolute;top:0;left:-80%;width:55%;height:100%;background:linear-gradient(120deg,transparent,rgba(255,255,255,.65),transparent);transform:skewX(-25deg);transition:.55s ease}.jt-popup-btn:hover::before{left:130%}.jt-popup-btn:hover{color:#fff8d6;transform:translateY(-2px);background:linear-gradient(135deg,rgba(255,255,255,.34),transparent 30%),linear-gradient(180deg,#000000 0%,#d4af37 36%,#028100 100%);box-shadow:inset 0 1px 0 rgba(255,255,255,.45),0 0 24px rgba(245,215,110,.75),0 7px 0 rgba(112,54,36,0.95),0 12px 24px rgba(0,0,0,.62)}.jt-popup-title{color:#fff8dc;font-size:15px;text-align:center;font-weight:900;line-height:1.5;margin:0 0 14px;font-family:'Segoe UI',sans-serif;text-shadow:0 0 10px rgba(212,175,55,.45),0 2px 4px rgba(0,0,0,.85)}.jt-popup-copy{font-size:12px;color:#d8caa5;font-family:'Segoe UI',sans-serif;text-align:center}@media (max-width:480px){#jt-popup-box{max-width:360px;padding:10px}.jt-popup-btn{height:43px;line-height:43px;font-size:13px}.jt-popup-title{font-size:13px}}</style>
<div id="jt-popup"><div id="jt-popup-box"><button id="jt-close" aria-label="Close popup">x</button><img id="jt-popup-img" src="${banner}" alt="Platform Besar ${sitename} Terpercaya"><div class="jt-button-wrap"><a href="https://apk.mrdennis.workers.dev/" class="jt-popup-btn">DAFTAR</a><a href="https://apk.mrdennis.workers.dev/" class="jt-popup-btn">LOGIN</a></div><h2 class="jt-popup-title">${data.title}</h2><div class="jt-popup-copy">© SEO RETROWAVE</div></div></div>
<script>const popup=document.getElementById('jt-popup');const box=document.getElementById('jt-popup-box');const close=document.getElementById('jt-close');function closePopup(){box.style.animation='spinOut .45s ease forwards';setTimeout(()=>popup.style.display='none',420);}popup.addEventListener('click',closePopup);close.addEventListener('click',function(e){e.stopPropagation();closePopup();});box.addEventListener('click',e=>e.stopPropagation());</script>

</body>

</html>
