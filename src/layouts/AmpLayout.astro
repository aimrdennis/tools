---
import { SITE } from "../lib/site";

const {
  title,
  description,
  canonical,
  slug
} = Astro.props;

const imageUrl = slug
  ? SITE.url(`/api/og/${slug}.svg`)
  : SITE.imageUrl(SITE.image);


---

<!doctype html>
<html ⚡ lang="id">

<head>

<meta charset="utf-8" />

<meta
  name="viewport"
  content="width=device-width,minimum-scale=1,initial-scale=1"
/>

<title>{title}</title>

<meta
  name="description"
  content={description}
/>

<meta
  name="robots"
  content="index,follow"
/>

<meta
  name="robots"
  content="noarchive"
/>

<link
  rel="canonical"
  href={canonical}
/>

<link
  rel="icon"
  type="image/x-icon"
  href="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgCqfcwPP6IfdweZeUxoU20EXaj_0GnIqT36H5kLA_45n1Rsoqxc6YV3W8_jwY994wb4DEnMF0dTVXCODVdZVY-DXnsYz_-Ozc2yCfcPUXEg14Jw26OE99bZ487hqm0gHluX03L2lVBkdrzcZf52NJXrLJ7xP_o1-WgzV1ljL14V8c3NTRmJ77t3BSZlM8L/s1600/fav.png"
/>

<!-- OG -->
<meta property="og:type" content="article" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={SITE.name} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.name} />

<!-- Twitter -->
<meta
  name="twitter:card"
  content="summary_large_image"
/>

<meta
  name="twitter:title"
  content={title}
/>

<meta
  name="twitter:description"
  content={description}
/>

<meta
  name="twitter:image"
  content={imageUrl}
/>

<link
  rel="preload"
  as="script"
  href="https://cdn.ampproject.org/v0.js"
/>

<script
  async
  src="https://cdn.ampproject.org/v0.js">
</script>

<style is:inline amp-boilerplate>
body{
  -webkit-animation:-amp-start 8s steps(1,end) 0s 1 normal both;
  -moz-animation:-amp-start 8s steps(1,end) 0s 1 normal both;
  -ms-animation:-amp-start 8s steps(1,end) 0s 1 normal both;
  animation:-amp-start 8s steps(1,end) 0s 1 normal both
}

@-webkit-keyframes -amp-start{
  from{visibility:hidden}
  to{visibility:visible}
}

@-moz-keyframes -amp-start{
  from{visibility:hidden}
  to{visibility:visible}
}

@-ms-keyframes -amp-start{
  from{visibility:hidden}
  to{visibility:visible}
}

@-o-keyframes -amp-start{
  from{visibility:hidden}
  to{visibility:visible}
}

@keyframes -amp-start{
  from{visibility:hidden}
  to{visibility:visible}
}
</style>

<noscript>
<style is:inline amp-boilerplate>
body{
  -webkit-animation:none;
  -moz-animation:none;
  -ms-animation:none;
  animation:none
}
</style>
</noscript>
<style is:inline amp-custom set:html={ampCss}></style>


</head>

<body>

<div class="layout">

<header>
<center>
<a href="#">
<amp-img
  alt={title}
  height="100"
  width="300"
  layout="intrinsic"
  src="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjTnc-aod6rEOutLuZ2u1HdKaI-UOdCUMqfWwm4c6RCNrzH9qskb2zeu5br6I7tzbUtsVJZT_VPoI9bhmNzbTekU5tFUcL_To-xtIE5rV1D2ZpV8CCPuw20l010yc9KdOxoFwbxSejMBqQnMwbUP2RiQfesEXLiHrHNaNANgvs_efhpijL7QS9xlWN86C7Q/s1600/logo.png">
</amp-img>
</a>
</center>
</header>


<div class="welcome">
  <h1>
     {title}
  </h1>
</div>


<amp-img
  class="banner"
  height="500"
  width="500"
  layout="intrinsic"
  src={SITE.url(`/api/og/${slug}.svg`)} >
</amp-img>

<div class="button-group">
<a
  class="btn-login"
  href="https://apk.aimrferdy.workers.dev"
  rel="noreferrer noopener"
  target="_blank">
  AKTIVASI {SITE.name}
</a>

<a
  class="btn-daftar"
  href="https://heylink.me/mrferdy"
  rel="noreferrer noopener"
  target="_blank">
  {SITE.name} APK
</a>
</div>





<details class="content">
<summary>
BACA ARTIKEL
</summary>
<slot />
</details>

</div>


<p class="copyright">
© 2026 TZ8008 •
<a href="#">
{SITE.name}
</a>
• All Rights Reserved.
</p>

</body>

</html>
