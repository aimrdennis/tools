---
import MainLayout from "../layouts/MainLayout.astro";

import NewsCard from "../components/NewsCard.astro";
import Trending from "../components/Trending.astro";

import { SITE } from "../lib/site";

import {
  sortPosts,
  publishedPosts
} from "../lib/utils";

import {
  getCollection
} from "astro:content";

// get posts

let posts =
  await getCollection("blog");

// published only

posts =
  publishedPosts(posts);

// latest first

posts =
  sortPosts(posts);

// hero post

const hero =
  posts[0];

// latest posts

const latestPosts =
  posts.slice(1, 7);

// trending

const trendingPosts =
  posts.slice(0, 5);
---

<MainLayout
  title={SITE.title}
  description={SITE.description}
  canonical={SITE.url()}
>

  <!-- hero -->

  {hero && (

  <section class="blog-hero">

    <a
      href={`/blog/${hero.slug}/`}
      class="blog-hero-card">

      <img
        src={SITE.url(`/api/og/${hero.slug}.svg`)}
        alt={hero.data.title}
        width="1200"
        height="630"
      />

      <div class="blog-hero-overlay">
      </div>

      <div class="blog-hero-content">

        <div class="blog-hero-category">

          {hero.data.category || "News"}

        </div>

        <h1 class="blog-hero-title">

          {hero.data.title}

        </h1>

        <p class="blog-hero-description">

          {hero.data.description}

        </p>

      </div>

    </a>

  </section>

  )}

  <!-- content -->

  <div class="main-grid">

    <!-- left -->

    <section>

      <div class="section-title">

        <h2>
          Latest Posts
        </h2>

      </div>

      <div class="blog-grid">

        {latestPosts.map((post) => (

          <NewsCard post={post} />

        ))}

      </div>

    </section>

    <!-- right -->

    <aside class="blog-sidebar">

      <Trending
        posts={trendingPosts}
      />

    </aside>

  </div>

</MainLayout>
