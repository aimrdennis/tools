---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE } from '../lib/site';


const pageTitle =
  'Tools Ai Mr Dennis - Teknologi, AI, Tools, SEO & Digital Modern';

const pageDescription =
  'Ai Mr Dennis membahas AI, teknologi, SEO, tools digital, tutorial modern, automation, dan insight internet terbaru dengan tampilan cepat dan ringan.';
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={SITE.url()}
>

  <!-- ========================= -->
  <!-- HERO HEADER -->
  <!-- ========================= -->

  <section
    class="relative overflow-hidden border-b border-zinc-800 bg-black text-white"
  >
    <div
      class="absolute inset-0 opacity-20"
      style="
        background-image:
          radial-gradient(circle at top left,#facc15 0%,transparent 30%),
          radial-gradient(circle at bottom right,#eab308 0%,transparent 30%);
      "
    ></div>

    <div class="relative mx-auto max-w-7xl px-6 py-24 lg:px-10">

      <div class="max-w-3xl">

        <span
          class="mb-5 inline-flex rounded-full border border-yellow-500/40 bg-yellow-500/10 px-4 py-1 text-sm font-semibold text-yellow-400"
        >
          ⚡ Lebah Hack Digital Ecosystem
        </span>

        <h1
          class="text-4xl font-black leading-tight tracking-tight sm:text-5xl lg:text-6xl"
        >
          Bangun Website Modern,
          SEO Powerful,
          dan Sistem AI Masa Kini
        </h1>

        <p
          class="mt-6 max-w-2xl text-base leading-8 text-zinc-300 sm:text-lg"
        >
          Lebah Hack menghadirkan insight teknologi, AI tools,
          automation, SEO strategy, Astro framework,
          performa website cepat, dan eksperimen digital modern.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">

          <a
            href="/blog"
            class="rounded-xl bg-yellow-400 px-6 py-3 font-bold text-black transition hover:scale-105"
          >
            Jelajahi Artikel
          </a>

          <a
            href="/about"
            class="rounded-xl border border-zinc-700 px-6 py-3 font-semibold text-white transition hover:border-yellow-400 hover:text-yellow-400"
          >
            Tentang Lebah Hack
          </a>

        </div>

      </div>

    </div>
  </section>

  <!-- ========================= -->
  <!-- HEADER COMPONENTS -->
  <!-- ========================= -->


  <!-- ========================= -->
  <!-- MAIN CONTENT -->
  <!-- ========================= -->

  <main class="bg-zinc-950 text-white">

    <!-- FEATURE SECTION -->

    <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10">

      <div class="mb-14 text-center">

        <h2 class="text-3xl font-black sm:text-4xl">
          Kenapa Memilih Lebah Hack?
        </h2>

        <p class="mx-auto mt-4 max-w-2xl text-zinc-400">
          Fokus pada performa, branding, SEO modern,
          dan teknologi masa depan dengan pengalaman ringan dan cepat.
        </p>

      </div>

      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">

        <div class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6">
          <div class="text-3xl">🚀</div>
          <h3 class="mt-4 text-xl font-bold">
            Ultra Fast Website
          </h3>
          <p class="mt-3 text-sm leading-7 text-zinc-400">
            Dibangun menggunakan Astro untuk performa super ringan
            dan loading cepat.
          </p>
        </div>

        <div class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6">
          <div class="text-3xl">🤖</div>
          <h3 class="mt-4 text-xl font-bold">
            AI & Automation
          </h3>
          <p class="mt-3 text-sm leading-7 text-zinc-400">
            Eksplorasi AI tools, workflow automation,
            dan sistem digital modern.
          </p>
        </div>

        <div class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6">
          <div class="text-3xl">📈</div>
          <h3 class="mt-4 text-xl font-bold">
            SEO Strategy
          </h3>
          <p class="mt-3 text-sm leading-7 text-zinc-400">
            Optimasi ranking, topical authority,
            dan struktur website modern.
          </p>
        </div>

        <div class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6">
          <div class="text-3xl">🛡️</div>
          <h3 class="mt-4 text-xl font-bold">
            Clean Architecture
          </h3>
          <p class="mt-3 text-sm leading-7 text-zinc-400">
            Struktur project lebih rapi,
            scalable, dan mudah maintenance.
          </p>
        </div>

      </div>

    </section>

    <!-- FOOTER COMPONENTS -->


<style>
/* =========================================
   LEBAH HACK GLOBAL STYLE
   /src/styles/global.css
========================================= */

:root{
  --bg:#050505;
  --card:#111111;
  --soft:#181818;

  --text:#ffffff;
  --muted:#a1a1aa;

  --primary:#facc15;
  --primary-2:#eab308;

  --border:#27272a;

  --shadow:
    0 10px 30px rgba(0,0,0,.35);

  --radius:22px;

  --container:1280px;
}

/* =========================================
   RESET
========================================= */

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  background:var(--bg);
  color:var(--text);

  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    sans-serif;

  line-height:1.7;
  overflow-x:hidden;
}

/* =========================================
   CONTAINER
========================================= */

.container{
  width:100%;
  max-width:var(--container);

  margin-inline:auto;
  padding-inline:24px;
}

/* =========================================
   LINKS
========================================= */

a{
  color:inherit;
  text-decoration:none;
}

img{
  max-width:100%;
  display:block;
}

/* =========================================
   SECTION
========================================= */

.section{
  padding:90px 0;
}

.section-title{
  font-size:clamp(2rem,4vw,3rem);
  font-weight:900;
  line-height:1.15;

  margin-bottom:18px;
}

.section-desc{
  color:var(--muted);
  max-width:720px;
}

/* =========================================
   HERO
========================================= */

.hero{
  position:relative;
  overflow:hidden;

  border-bottom:1px solid var(--border);

  background:
    radial-gradient(
      circle at top left,
      rgba(250,204,21,.18),
      transparent 30%
    ),
    radial-gradient(
      circle at bottom right,
      rgba(234,179,8,.14),
      transparent 30%
    ),
    var(--bg);
}

.hero-inner{
  min-height:88vh;

  display:flex;
  align-items:center;
}

.hero-content{
  max-width:760px;
}

.hero-badge{
  display:inline-flex;
  align-items:center;
  gap:10px;

  padding:10px 18px;

  border-radius:999px;

  border:1px solid rgba(250,204,21,.25);

  background:rgba(250,204,21,.08);

  color:var(--primary);

  font-size:.9rem;
  font-weight:700;

  margin-bottom:26px;
}

.hero-title{
  font-size:clamp(3rem,8vw,6rem);
  line-height:1.05;
  font-weight:900;
  letter-spacing:-2px;
}

.hero-title span{
  color:var(--primary);
}

.hero-text{
  margin-top:28px;

  color:var(--muted);

  font-size:1.1rem;
  max-width:680px;
}

.hero-actions{
  margin-top:40px;

  display:flex;
  flex-wrap:wrap;
  gap:16px;
}

/* =========================================
   BUTTONS
========================================= */

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;

  min-height:56px;

  padding:0 28px;

  border-radius:18px;

  font-weight:700;

  transition:.25s ease;
}

.btn-primary{
  background:var(--primary);
  color:#000;
}

.btn-primary:hover{
  transform:translateY(-3px);
  background:var(--primary-2);
}

.btn-outline{
  border:1px solid var(--border);
  background:transparent;
}

.btn-outline:hover{
  border-color:var(--primary);
  color:var(--primary);
}

/* =========================================
   GRID FEATURE
========================================= */

.feature-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:24px;

  margin-top:60px;
}

.feature-card{
  background:var(--card);

  border:1px solid var(--border);

  border-radius:var(--radius);

  padding:30px;

  transition:.25s ease;

  box-shadow:var(--shadow);
}

.feature-card:hover{
  transform:translateY(-6px);
  border-color:rgba(250,204,21,.35);
}

.feature-icon{
  font-size:2.4rem;
}

.feature-title{
  margin-top:20px;

  font-size:1.25rem;
  font-weight:800;
}

.feature-text{
  margin-top:14px;

  color:var(--muted);
  font-size:.96rem;
}

/* =========================================
   CARD
========================================= */

.card{
  background:var(--card);

  border:1px solid var(--border);

  border-radius:var(--radius);

  padding:28px;

  box-shadow:var(--shadow);
}

/* =========================================
   FOOTER
========================================= */

.footer{
  border-top:1px solid var(--border);

  background:#080808;
}

.footer-inner{
  padding:70px 0;
}

.footer-logo{
  font-size:1.8rem;
  font-weight:900;

  color:var(--primary);
}

.footer-text{
  margin-top:18px;

  color:var(--muted);

  max-width:620px;
}

/* =========================================
   RESPONSIVE
========================================= */

@media (max-width:1024px){

  .feature-grid{
    grid-template-columns:repeat(2,1fr);
  }

}

@media (max-width:768px){

  .section{
    padding:70px 0;
  }

  .hero-inner{
    min-height:auto;
    padding:90px 0;
  }

  .hero-title{
    line-height:1.1;
  }

  .hero-actions{
    flex-direction:column;
  }

  .btn{
    width:100%;
  }

  .feature-grid{
    grid-template-columns:1fr;
  }

}

@media (max-width:480px){

  .container{
    padding-inline:18px;
  }

  .hero-badge{
    font-size:.8rem;
  }

  .feature-card{
    padding:24px;
  }

}
</style>



  </main>

</MainLayout>
