---
import MainLayout from "../../layouts/MainLayout.astro";

import TOC from "../../components/TOC.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import Trending from "../../components/Trending.astro";

import { SITE } from "../../lib/site";

import {
  formatDate,
  readingTime,
  sortPosts,
  publishedPosts
} from "../../lib/utils";

import {
  getCollection,
  render
} from "astro:content";

// ======================
// STATIC PATHS
// ======================

export async function getStaticPaths() {

  const posts =
    await getCollection("blog");

  return posts.map((post) => ({

    params: {
      slug: post.slug
    },

    props: {
      post
    }

  }));

}

// ======================
// POST
// ======================

const {
  post
} = Astro.props;

// render

const {
  Content
} = await render(post);

// toc markdown

const html =
  post.body;

// posts

let posts =
  await getCollection("blog");

posts =
  publishedPosts(posts);

posts =
  sortPosts(posts);

// image

const imageUrl =
  SITE.url(`/api/og/${post.slug}.svg`);

// meta

const postUrl =
  SITE.url(`/blog/${post.slug}`);

const ampUrl =
  SITE.url(`/blog/${post.slug}/amp`);

const publishDate =
  formatDate(post.data.date);

const readTime =
  readingTime(post.body);

// schema

const articleSchema = {

  "@context":
    "https://schema.org",

  "@type":
    "Article",

  headline:
    post.data.title,

  description:
    post.data.description,

  image:
    imageUrl,

  datePublished:
    post.data.date,

  author: {

    "@type":
      "Person",

    name:
      post.data.author ||
      SITE.author

  },

  publisher: {

    "@type":
      "Organization",

    name:
      SITE.title

  },

  mainEntityOfPage:
    postUrl

};

// breadcrumbs

const breadcrumbs = {

  "@context":
    "https://schema.org",

  "@type":
    "BreadcrumbList",

  itemListElement: [

    {
      "@type":
        "ListItem",

      position: 1,

      name: "Home",

      item:
        SITE.url()
    },

    {
      "@type":
        "ListItem",

      position: 2,

      name: "Blog",

      item:
        SITE.url("/blog")
    },

    {
      "@type":
        "ListItem",

      position: 3,

      name:
        post.data.title,

      item:
        postUrl
    }

  ]

};
---

<MainLayout
  title={`${post.data.title} | ${SITE.title}`}
  description={post.data.description}
  canonical={postUrl}
  amp={ampUrl}
  type="article"
  image={imageUrl}
  slug={post.slug}
  articleSchema={articleSchema}
  breadcrumbs={breadcrumbs}
>

  <div class="article-wrapper">

    <!-- article -->

    <article class="article-container">

      <!-- breadcrumb -->

      <div class="article-breadcrumb">

        <a href="/">
          Home
        </a>

        <span>
          /
        </span>

        <a href="/blog/">
          Blog
        </a>

        <span>
          /
        </span>

        <span>
          {post.data.category}
        </span>

      </div>

      <!-- category -->

      <div class="article-category">

        {post.data.category}

      </div>

      <!-- title -->

      <h1 class="article-title">

        {post.data.title}

      </h1>

      <!-- desc -->

      <p class="article-description">

        {post.data.description}

      </p>

      <!-- meta -->

      <div class="article-meta">

        <div class="article-meta-left">

          <span>
            📅 {publishDate}
          </span>

          <span>
            ⏱️ {readTime}
          </span>

        </div>

        <div class="article-meta-right">

          ✍️ {
            post.data.author ||
            SITE.author
          }

        </div>

      </div>

      <!-- image -->

      <div class="article-image">

        <img
          src={imageUrl}
          alt={post.data.title}
          width="1200"
          height="630"
          loading="eager"
        />

      </div>

      <!-- layout -->

      <div class="article-layout">

        <!-- main -->

        <main class="article-main">

          <!-- toc -->

          <TOC html={html} />

          <!-- content -->

          <div class="article-content">

            <Content />

          </div>

          <!-- tags -->

          {post.data.tags?.length > 0 && (

          <div class="article-tags">

            {post.data.tags.map((tag) => (

              <a href={`/tag/${tag}/`}>

                #{tag}

              </a>

            ))}

          </div>

          )}

          <!-- related -->

          <RelatedPosts
            posts={posts}
            currentSlug={post.slug}
            category={post.data.category}
          />

        </main>

        <!-- sidebar -->

        <aside class="article-sidebar">

          <div class="sidebar-sticky">

            <Trending
              posts={posts}
            />

          </div>

        </aside>

      </div>

    </article>

  </div>

</MainLayout>
