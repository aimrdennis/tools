---
import MainLayout from "../../layouts/MainLayout.astro";

import NewsCard from "../../components/NewsCard.astro";
import Trending from "../../components/Trending.astro";

import { SITE } from "../../lib/site";

import {
  sortPosts,
  publishedPosts
} from "../../lib/utils";

import {
  getCollection
} from "astro:content";

// get posts

let posts =
  await getCollection("blog");

// publish only

posts =
  publishedPosts(posts);

// latest first

posts =
  sortPosts(posts);

// latest posts

const latestPosts =
  posts.slice(0, 12);

// trending

const trendingPosts =
  posts.slice(0, 5);
---

<MainLayout
  title={`Blog | ${SITE.title}`}
  description={SITE.description}
  canonical={SITE.url("/blog")}
>

  <!-- page title -->

  <section class="section">

    <div class="section-title">

      <h1>
        Latest Articles
      </h1>

    </div>

    <p>
      Update terbaru seputar SEO,
      AI, teknologi, crypto,
      web development, dan digital tools.
    </p>

  </section>

  <!-- content -->

  <div class="main-grid">

    <!-- left -->

    <section>

      <div class="blog-grid">

        {latestPosts.map((post) => (

          <NewsCard post={post} />

        ))}

      </div>

    </section>

    <!-- right -->

    <aside class="blog-sidebar">

      <Trending
        posts={trendingPosts}
      />

    </aside>

  </div>

</MainLayout>
